# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# .vscode/launch.json is committed, carrying placeholder keys — the
# RevenueCat SDK keys are publishable, so the value of everyone starting from
# a working config beats keeping the file out. Fill it in locally and keep
# your edit out of git with:
#
#   git update-index --skip-worktree .vscode/launch.json
#
# A whole file of real per-environment values is a different thing, and stays
# out. See docs/REVENUECAT.md §5.
*.dart-define.json
