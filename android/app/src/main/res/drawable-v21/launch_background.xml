<?xml version="1.0" encoding="utf-8"?>
<!-- The native splash: the app's canvas colour and nothing else, which is
     what Flutter's own launch state draws too, so the handoff is invisible
     because there is nothing to hand over. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
